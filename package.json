{
  "name": "supply-srv",
  "version": "0.0.1",
  "private": true,
  "description": "SAP CAP service exposing supply requests over OData V2",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "cds-serve",
    "test": "jest",
    "deploy": "cds-deploy"
  },
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1",
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^2",
    "jest": "^30"
  },
  "cds": {
    "i18n": {
      "default_language": "es"
    },
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        },
        "[production]": {
          "kind": "hana",
          "impl": "@cap-js/hana"
        }
      }
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "testTimeout": 30000
  }
}
